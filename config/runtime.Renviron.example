# Optional settings for this clone. Copy to runtime.Renviron only when needed.
# New clones use Data sources profiles; no private VCF/BAM manifest paths needed.
# RStudio already supplies its own startup tempdir and R library paths.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
REGSHINY_SGE_PROJECT=mtdna-alcohol
# Each new full variant job requests 16 cores independently.
REGSHINY_FULL_WALLTIME=12:00:00
# Optional custom initial dataset, kept outside Git:
# REGSHINY_PROFILE_CONFIG=/absolute/path/to/my-profile.json
# Optional worker reduction within the RStudio NSLOTS budget:
# REGSHINY_UI_WORKERS=1
# Optional reference sources for the Variant interpretation tab (defaults are the
# lab copies on SCC; an unreadable source is skipped). See docs/INTERPRETATION.md.
# REGSHINY_TABIX=/path/to/tabix
# REGSHINY_CADD_SNV=/path/to/whole_genome_SNVs.tsv.gz
# REGSHINY_CADD_INDEL=/path/to/gnomad.genomes.r4.0.indel.tsv.gz
# REGSHINY_VEP_CACHE=/path/to/homo_sapiens/112_GRCh38
# REGSHINY_TOPMED_QTL=/path/to/TOPMed_cis-sQTL
# REGSHINY_FHS_SQTL=/path/to/discovery.csv;/path/to/replication.csv
# REGSHINY_FHS_EQTL=/path/to/position_sorted_gene_eqtl.csv
# REGSHINY_SPLICEAI=/path/to/spliceai
# REGSHINY_GWAS_CATALOG=/path/to/gwas_catalog_eNNN_rYYYY-MM-DD.b38.tsv.gz   (scripts/build_gwas_index.sh)
# REGSHINY_CLINVAR_VCF=/path/to/clinvar.vcf.gz                              (bgzip + tabix -p vcf)
# REGSHINY_REACTOME=/path/to/reactome_ensembl_all_levels.human.tsv          (scripts/build_pathway_index.sh)
# REGSHINY_MSIGDB=/path/to/msigdb/release_directory
# REGSHINY_TISSUE_MODEL_EQTL=/path/to/tissue_sharing_eqtl.json              (scripts/train_tissue_model.R)
# REGSHINY_TISSUE_MODEL_SQTL=/path/to/tissue_sharing_sqtl.json
